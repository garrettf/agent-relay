#!/bin/sh
# Runs node with whatever runtime this machine has: the Codex app launches MCP
# servers and hooks with a minimal PATH, so search the usual places.
set -eu
for candidate in \
  "${CODEX_MCP_NODE_PATH:-}" \
  "${CODEX_ELECTRON_RESOURCES_PATH:-}/cua_node/bin/node" \
  "${HOME:-}/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node" \
  "$(command -v node 2>/dev/null || true)" \
  "${HOME:-}/.n/bin/node" \
  "${HOME:-}/.volta/bin/node" \
  /opt/homebrew/bin/node \
  /usr/local/bin/node
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done
echo "claude-relay: no node runtime found" >&2
exit 127
