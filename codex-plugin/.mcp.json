{
  "mcpServers": {
    "claude_relay": {
      "command": "./scripts/node",
      "args": [
        "./server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH",
        "AGENT_RELAY_HOME",
        "CODEX_MCP_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 3600,
      "default_tools_approval_mode": "approve"
    }
  }
}
